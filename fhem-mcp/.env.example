# FHEM MCP Server Environment Variables

# API Key for securing the MCP server endpoints
MCP_API_KEY="your-secure-random-key-here"

# FHEM Server URL
FHEM_URL="http://192.168.178.15:8085/fhem"

# HTTP Basic Auth for FHEMWEB (optional)
# Format: "username:password"
# Example: FHEM_AUTH="mcpuser:ein-langes-zufaelliges-passwort"
FHEM_AUTH="mcpuser:ein-langes-zufaelliges-passwort"

# DNS rebinding protection (MCP SDK >= 1.23): comma-separated allowed Host headers (optional)
# Format: "host:port" or "host:*" - loopback (localhost/127.0.0.1) is always allowed
# Example: MCP_ALLOWED_HOSTS="192.168.178.10:5887,fhem-mcp.fritz.box:5887"
MCP_ALLOWED_HOSTS="192.168.178.10:5887"

# Kill-switch: set to "false" to disable the DNS rebinding protection entirely
# (only safe because /mcp is protected by the X-API-Key middleware)
# MCP_DNS_REBINDING_PROTECTION="false"
