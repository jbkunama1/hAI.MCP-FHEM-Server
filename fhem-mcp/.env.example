# FHEM MCP Server Environment Variables

# API Key for securing the MCP server endpoints
MCP_API_KEY="your-secure-random-key-here"

# FHEM Server URL (FHEMWEB device; path = webname attribute, default /fhem)
FHEM_URL="http://192.168.178.15:4321/fhem"

# Optional auth for the default FHEM instance:
#   "user:password"  -> HTTP Basic Auth (FHEMWEB basicAuth)
#   anything else    -> sent as "Authorization: Bearer <value>"
FHEM_AUTH=""
